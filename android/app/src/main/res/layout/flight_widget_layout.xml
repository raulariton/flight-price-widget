<?xml version="1.0" encoding="utf-8"?>
<!--
  Home screen widget layout.
  Uses a RemoteViews-compatible view hierarchy (no custom views).
  All text IDs are referenced by FlightWidgetProvider.kt when populating data.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header row: airplane icon + "Flight Tracker" label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✈  Flight Tracker"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:textStyle="normal"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- Route: e.g. "SFO → JFK" -->
    <TextView
        android:id="@+id/widget_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="---"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Departure date -->
    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="---"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp" />

    <!-- Price — large and prominent -->
    <TextView
        android:id="@+id/widget_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="---"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Last updated timestamp -->
    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#80FFFFFF"
        android:textSize="9sp" />

</LinearLayout>
